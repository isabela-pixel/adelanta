# Clave secreta de tu integración de Notion (notion.so/profile/integrations)
NOTION_TOKEN=

# Contraseña para entrar al dashboard (la eliges tú)
DASHBOARD_PASSWORD=

# Clave larga para que GitHub Actions pueda pedir los recordatorios (la misma va en los secrets de GitHub)
CRON_SECRET=

# Recordatorios por correo (resend.com, plan gratis)
RESEND_API_KEY=
# El correo con el que creaste la cuenta de Resend (en el plan gratis solo puede enviarte a ti)
NOTIFY_EMAIL=

# URL pública del dashboard en Vercel (para el botón del correo)
DASHBOARD_URL=

# IDs de las bases de Notion (ya vienen por defecto; solo cámbialos si las mueves)
# NOTION_TAREAS_DB=443b739f3fce48b0ab300892bcdb0ce8
# NOTION_BANDEJA_DB=e3dce20a73ab4c89a2242605efa7c640
